# Создайте файл .env в этой же папке (frontend/) и вставьте ваши ключи.
# ВНИМАНИЕ: Файл .env содержит секретные ключи, никогда не коммитьте его в git!

# Токен вашего Telegram-бота (полученный у @BotFather)
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here

# Ваш Chat ID или ID группы (полученный у @userinfobot или аналогичного)
VITE_TELEGRAM_CHAT_ID=your_chat_id_here
